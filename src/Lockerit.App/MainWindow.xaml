<Window x:Class="Lockerit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Lockerit"
        Height="780"
        Width="1180"
        MinHeight="680"
        MinWidth="980"
        Background="#0E0F0D">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0E0F0D" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#121311" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#171816" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#20211E" />
        <SolidColorBrush x:Key="InputBrush" Color="#121311" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#34352F" />
        <SolidColorBrush x:Key="BorderBrushStrong" Color="#4B4C44" />
        <SolidColorBrush x:Key="InkBrush" Color="#F2EFE7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A9A39A" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#7E786F" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#D97757" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#B8694D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7AA7D9" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#65B891" />
        <SolidColorBrush x:Key="WarningBrush" Color="#E1A34A" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E06A5F" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          ClickMode="Press"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Focusable="False"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="{StaticResource InputBrush}"
                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  Margin="12,0,32,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True" />
                                                <Path Width="10"
                                                      Height="6"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      Fill="{StaticResource MutedBrush}"
                                                      Stretch="Uniform"
                                                      Data="M4,8 L12,16 L20,8 Z" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#272823" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#251C17" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="#20211E" />
            <Setter Property="BorderBrush" Value="#34352F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="ToolTipService.ShowDuration" Value="6000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#272823" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#4B4C44" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="#0E0F0D" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="#693B35" />
            <Setter Property="Background" Value="#211715" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="PrimaryIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="#0E0F0D" />
        </Style>

        <Style x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="#693B35" />
            <Setter Property="Background" Value="#211715" />
        </Style>

        <Style x:Key="BareIconButton" TargetType="Button">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#251C17" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#744532" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#20211E" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#34352F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="LoginSurface" Background="{StaticResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="28,0">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="8"
                            Background="#251C17"
                            BorderBrush="#744532"
                            BorderThickness="1"
                            Margin="0,0,10,0">
                        <Path Fill="{StaticResource PrimaryBrush}"
                              Stretch="Uniform"
                              Margin="8"
                              Data="M12,2 C8.7,2 6,4.7 6,8 L6,10 L5,10 C3.9,10 3,10.9 3,12 L3,21 C3,22.1 3.9,23 5,23 L19,23 C20.1,23 21,22.1 21,21 L21,12 C21,10.9 20.1,10 19,10 L18,10 L18,8 C18,4.7 15.3,2 12,2 Z M8,10 L8,8 C8,5.8 9.8,4 12,4 C14.2,4 16,5.8 16,8 L16,10 Z" />
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Locker"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="it"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="OpenReadmeMenuItem_Click">
                    <TextBlock Text="Docs"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </DockPanel>

            <Grid Grid.Row="1" Margin="28">
                <Border Width="720"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="34">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Unlock your vault"
                                       FontSize="28"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Your secrets stay local. Lockerit verifies the current Windows account before opening this vault."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="14"
                                       Margin="0,12,0,0" />

                            <TextBlock Text="Windows account" Style="{StaticResource FieldLabel}" Margin="0,28,0,6" />
                            <TextBlock x:Name="UnlockWindowsUserText"
                                       FontSize="14"
                                       Foreground="{StaticResource InkBrush}" />

                            <TextBlock Text="Vault file" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="UnlockVaultPathText"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="12" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Margin="0,0,8,0" Click="BrowseVaultPathButton_Click">
                                    <TextBlock Text="Choose vault"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                                <Button Click="UseDefaultVaultPathButton_Click">
                                    <TextBlock Text="Use default"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                            </StackPanel>

                            <Button x:Name="UnlockButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,28,0,0"
                                    Click="UnlockButton_Click">
                                <TextBlock Text="Unlock"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="#121311"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <StackPanel>
                                <TextBlock Text="Recovery"
                                           Style="{StaticResource CaptionText}" />
                                <TextBlock Text="Portable keys"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,10,0,0" />
                                <TextBlock Text="Move a vault to this PC by choosing the vault database, importing its Recovery Kit, and creating a new Windows-protected keyring for this account."
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Margin="0,8,0,14" />
                                <Button x:Name="LoginImportRecoveryButton"
                                        HorizontalAlignment="Left"
                                        ToolTip="Import a Recovery Kit before unlocking a vault on this Windows account"
                                        Click="LoginImportRecoveryButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14"
                                              Height="14"
                                              Margin="0,0,8,0"
                                              Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M12,4 L12,16 M8,12 L12,16 L16,12 M5,20 L19,20" />
                                        <TextBlock Text="Import Recovery Kit"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="#0E0F0D"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SubtleBrush}"
                           FontSize="12" />
            </Border>
        </Grid>

        <Grid x:Name="ShellSurface"
              Visibility="Collapsed"
              Background="{StaticResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#121311"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="248" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30"
                                Height="30"
                                CornerRadius="7"
                                Background="#251C17"
                                BorderBrush="#744532"
                                BorderThickness="1"
                                Margin="0,0,10,0">
                            <Path Fill="{StaticResource PrimaryBrush}"
                                  Stretch="Uniform"
                                  Margin="7"
                                  Data="M12,2 C8.7,2 6,4.7 6,8 L6,10 L5,10 C3.9,10 3,10.9 3,12 L3,21 C3,22.1 3.9,23 5,23 L19,23 C20.1,23 21,22.1 21,21 L21,12 C21,10.9 20.1,10 19,10 L18,10 L18,8 C18,4.7 15.3,2 12,2 Z M8,10 L8,8 C8,5.8 9.8,4 12,4 C14.2,4 16,5.8 16,8 L16,10 Z" />
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Locker"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="it"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Button x:Name="AccountButton"
                                Style="{StaticResource BareIconButton}"
                                Width="42"
                                Height="42"
                                Padding="0"
                                ToolTip="Open account menu"
                                Click="AccountButton_Click">
                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="16"
                                    Background="#251C17"
                                    BorderBrush="#744532"
                                    BorderThickness="1">
                                <TextBlock x:Name="AccountInitialsText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Button>

                        <Popup x:Name="AccountPopup"
                               PlacementTarget="{Binding ElementName=AccountButton}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="False">
                            <Border Width="272"
                                    Margin="0,8,0,0"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32"
                                                Height="32"
                                                CornerRadius="16"
                                                Background="#251C17"
                                                BorderBrush="#744532"
                                                BorderThickness="1">
                                            <TextBlock x:Name="AccountMenuInitialsText"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="AccountMenuNameText"
                                                       Foreground="{StaticResource InkBrush}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="Current Windows account"
                                                       Foreground="{StaticResource SubtleBrush}"
                                                       FontSize="12"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="0,1,0,0"
                                            Margin="0,0,0,8" />

                                    <Button Click="AccountLogoutButton_Click"
                                            HorizontalContentAlignment="Left"
                                            ToolTip="Log out of Lockerit and require authorization to reopen">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14"
                                                  Height="14"
                                                  Margin="0,0,8,0"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Data="M10,5 L5,5 L5,19 L10,19 M14,8 L18,12 L14,16 M8,12 L18,12" />
                                            <TextBlock Text="Log out"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Only this Windows account can unlock this vault."
                                               Foreground="{StaticResource SubtleBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="2,10,2,0" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,1,0">
                    <DockPanel Margin="18">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="WORKSPACE" Style="{StaticResource CaptionText}" Margin="2,0,0,6" />
                            <Button x:Name="VaultNavButton"
                                    Style="{StaticResource NavButton}"
                                    Click="VaultNavButton_Click">
                                <DockPanel>
                                    <Path DockPanel.Dock="Left"
                                          Width="15"
                                          Height="15"
                                          Margin="0,0,10,0"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Stretch="Uniform"
                                          Data="M12,2 C8.7,2 6,4.7 6,8 L6,10 L5,10 C3.9,10 3,10.9 3,12 L3,21 C3,22.1 3.9,23 5,23 L19,23 C20.1,23 21,22.1 21,21 L21,12 C21,10.9 20.1,10 19,10 L18,10 L18,8 C18,4.7 15.3,2 12,2 Z M8,10 L8,8 C8,5.8 9.8,4 12,4 C14.2,4 16,5.8 16,8 L16,10 Z" />
                                    <TextBlock Text="Passwords"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </DockPanel>
                            </Button>
                            <Button x:Name="FilesNavButton"
                                    Style="{StaticResource NavButton}"
                                    Click="FilesNavButton_Click">
                                <DockPanel>
                                    <Path DockPanel.Dock="Left"
                                          Width="15"
                                          Height="15"
                                          Margin="0,0,10,0"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Stretch="Uniform"
                                          Data="M5,3 L14,3 L19,8 L19,21 L5,21 Z M14,3 L14,8 L19,8" />
                                    <TextBlock Text="Files"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </DockPanel>
                            </Button>
                            <Button x:Name="SettingsNavButton"
                                    Style="{StaticResource NavButton}"
                                    Click="SettingsNavButton_Click">
                                <DockPanel>
                                    <Path DockPanel.Dock="Left"
                                          Width="15"
                                          Height="15"
                                          Margin="0,0,10,0"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Stretch="Uniform"
                                          Data="M12,8 C14.2,8 16,9.8 16,12 C16,14.2 14.2,16 12,16 C9.8,16 8,14.2 8,12 C8,9.8 9.8,8 12,8 Z M12,3 L13.2,5.4 L15.9,5.8 L16.4,8.5 L18.5,10.2 L17.2,12.7 L17.8,15.4 L15.4,16.8 L14.3,19.4 L11.6,19.2 L9.3,20.6 L7.6,18.5 L5,17.8 L5.1,15 L3.4,12.8 L4.8,10.4 L4.2,7.7 L6.6,6.3 L7.7,3.8 L10.4,4 Z" />
                                    <TextBlock Text="Settings"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </DockPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1" Margin="24">
                    <Grid x:Name="VaultContent">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <DockPanel Margin="20">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Passwords"
                                                   FontSize="22"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="EntryCountText"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Border Width="352"
                                                Background="{StaticResource InputBrush}"
                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,0">
                                            <DockPanel>
                                                <Path DockPanel.Dock="Left"
                                                      Width="15"
                                                      Height="15"
                                                      Margin="0,0,10,0"
                                                      Fill="{StaticResource SubtleBrush}"
                                                      Stretch="Uniform"
                                                      Data="M10,4 C6.7,4 4,6.7 4,10 C4,13.3 6.7,16 10,16 C11.4,16 12.7,15.5 13.7,14.7 L19,20 L20,19 L14.7,13.7 C15.5,12.7 16,11.4 16,10 C16,6.7 13.3,4 10,4 Z M10,6 C12.2,6 14,7.8 14,10 C14,12.2 12.2,14 10,14 C7.8,14 6,12.2 6,10 C6,7.8 7.8,6 10,6 Z" />
                                                <TextBox x:Name="SearchInput"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         ToolTip="Search by title, category, username, or URL"
                                                         TextChanged="SearchInput_TextChanged" />
                                            </DockPanel>
                                        </Border>

                                        <ComboBox x:Name="CategoryFilterComboBox"
                                                  Width="178"
                                                  Margin="8,0,8,0"
                                                  SelectedIndex="0"
                                                  ToolTip="Filter password entries by category"
                                                  SelectionChanged="CategoryFilterComboBox_SelectionChanged">
                                            <ComboBoxItem Content="All categories" Tag="All" />
                                            <ComboBoxItem Content="General" Tag="General" />
                                            <ComboBoxItem Content="Work" Tag="Work" />
                                            <ComboBoxItem Content="Personal" Tag="Personal" />
                                            <ComboBoxItem Content="Finance" Tag="Finance" />
                                            <ComboBoxItem Content="Social" Tag="Social" />
                                            <ComboBoxItem Content="Developer" Tag="Developer" />
                                            <ComboBoxItem Content="Other" Tag="Other" />
                                        </ComboBox>

                                        <Button Style="{StaticResource PrimaryButton}"
                                                MinWidth="112"
                                                ToolTip="Create a new password entry"
                                                Click="NewButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="14"
                                                      Height="14"
                                                      Margin="0,0,8,0"
                                                      Stretch="Uniform"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M12,5 L12,19 M5,12 L19,12" />
                                                <TextBlock Text="New item"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Background="#121311"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="156" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Title" Style="{StaticResource CaptionText}" />
                                            <TextBlock Grid.Column="1" Text="Category" Style="{StaticResource CaptionText}" />
                                            <TextBlock Grid.Column="2" Text="Username" Style="{StaticResource CaptionText}" />
                                            <TextBlock Grid.Column="3" Text="URL" Style="{StaticResource CaptionText}" />
                                            <TextBlock Grid.Column="4" Text="Updated" Style="{StaticResource CaptionText}" />
                                            <TextBlock Grid.Column="5" Text="Actions" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>

                                    <ListBox x:Name="PasswordList"
                                             Grid.Row="1"
                                             SelectionChanged="PasswordList_SelectionChanged"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="14,10" MinHeight="54">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2.2*" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="1.3*" />
                                                            <ColumnDefinition Width="1.5*" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="156" />
                                                        </Grid.ColumnDefinitions>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="34" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="24"
                                                                    Height="24"
                                                                    Background="#251C17"
                                                                    BorderBrush="#744532"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    VerticalAlignment="Center">
                                                                <Path Fill="{StaticResource PrimaryBrush}"
                                                                      Stretch="Uniform"
                                                                      Margin="6"
                                                                      Data="M12,2 C8.7,2 6,4.7 6,8 L6,10 L5,10 C3.9,10 3,10.9 3,12 L3,21 C3,22.1 3.9,23 5,23 L19,23 C20.1,23 21,22.1 21,21 L21,12 C21,10.9 20.1,10 19,10 L18,10 L18,8 C18,4.7 15.3,2 12,2 Z M8,10 L8,8 C8,5.8 9.8,4 12,4 C14.2,4 16,5.8 16,8 L16,10 Z" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="Encrypted entry"
                                                                           Foreground="{StaticResource SubtleBrush}"
                                                                           FontSize="11"
                                                                           Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <Border Grid.Column="1"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                Background="#251C17"
                                                                BorderBrush="#744532"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="9,4">
                                                            <TextBlock Text="{Binding Category}"
                                                                       Foreground="{StaticResource PrimaryBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Border>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding UserName}"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding Url}"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd}}"
                                                                   Foreground="{StaticResource SubtleBrush}"
                                                                   VerticalAlignment="Center" />

                                                        <StackPanel Grid.Column="5"
                                                                    Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource IconButton}"
                                                                    Margin="0,0,6,0"
                                                                    Tag="{Binding}"
                                                                    ToolTip="Copy username to clipboard"
                                                                    Click="CopyUserRowButton_Click">
                                                                <Path Width="15"
                                                                      Height="15"
                                                                      Stretch="Uniform"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.8"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      Data="M8,8 L18,8 L18,18 L8,18 Z M5,15 L5,5 L15,5" />
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}"
                                                                    Margin="0,0,6,0"
                                                                    Tag="{Binding}"
                                                                    ToolTip="Copy password to clipboard"
                                                                    Click="CopyPasswordRowButton_Click">
                                                                <Path Width="15"
                                                                      Height="15"
                                                                      Stretch="Uniform"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.8"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      Data="M15,7 C15,9.2 13.2,11 11,11 C8.8,11 7,9.2 7,7 C7,4.8 8.8,3 11,3 C13.2,3 15,4.8 15,7 Z M14,10 L21,17 M18,17 L21,17 L21,14" />
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}"
                                                                    Margin="0,0,6,0"
                                                                    Tag="{Binding}"
                                                                    ToolTip="Edit this password entry"
                                                                    Click="EditPasswordRowButton_Click">
                                                                <Path Width="15"
                                                                      Height="15"
                                                                      Stretch="Uniform"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.8"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      Data="M5,19 L8.5,18.2 L19,7.7 L16.3,5 L5.8,15.5 Z" />
                                                            </Button>
                                                            <Button Style="{StaticResource DangerIconButton}"
                                                                    Tag="{Binding}"
                                                                    ToolTip="Delete this password entry"
                                                                    Click="DeletePasswordRowButton_Click">
                                                                <Path Width="15"
                                                                      Height="15"
                                                                      Stretch="Uniform"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.8"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      Data="M6,7 L18,7 M9,7 L9,5 L15,5 L15,7 M8,9 L9,19 L17,19 L18,9" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel x:Name="EmptyPasswordsPanel"
                                                Grid.Row="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="260">
                                        <TextBlock Text="No passwords yet"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Create your first entry to start using the vault."
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,16" />
                                        <Button Style="{StaticResource PrimaryButton}"
                                                MinWidth="142"
                                                HorizontalAlignment="Center"
                                                Click="NewButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="14"
                                                      Height="14"
                                                      Margin="0,0,8,0"
                                                      Stretch="Uniform"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M12,5 L12,19 M5,12 L19,12" />
                                                <TextBlock Text="New password"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="FilesContent" Visibility="Collapsed">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <DockPanel Margin="20">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Files"
                                                   FontSize="22"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="FileCountText"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource PrimaryButton}"
                                            MinWidth="116"
                                            ToolTip="Encrypt and import a local file into this vault"
                                            Click="ImportFileButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14"
                                                  Height="14"
                                                  Margin="0,0,8,0"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Data="M12,20 L12,8 M8,12 L12,8 L16,12 M5,20 L19,20" />
                                            <TextBlock Text="Import file"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Background="#121311"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.4*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="96" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="File" Style="{StaticResource CaptionText}" />
                                            <TextBlock Grid.Column="1" Text="Category" Style="{StaticResource CaptionText}" />
                                            <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource CaptionText}" />
                                            <TextBlock Grid.Column="3" Text="Updated" Style="{StaticResource CaptionText}" />
                                            <TextBlock Grid.Column="4" Text="Actions" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>

                                    <ListBox x:Name="FileList"
                                             Grid.Row="1"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="14,10" MinHeight="54">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2.4*" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="96" />
                                                        </Grid.ColumnDefinitions>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="34" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="24"
                                                                    Height="24"
                                                                    Background="#251C17"
                                                                    BorderBrush="#744532"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    VerticalAlignment="Center">
                                                                <Path Fill="{StaticResource PrimaryBrush}"
                                                                      Stretch="Uniform"
                                                                      Margin="6"
                                                                      Data="M5,3 L14,3 L19,8 L19,21 L5,21 Z M14,3 L14,8 L19,8" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding FileName}"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="Encrypted attachment"
                                                                           Foreground="{StaticResource SubtleBrush}"
                                                                           FontSize="11"
                                                                           Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <Border Grid.Column="1"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                Background="#251C17"
                                                                BorderBrush="#744532"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="9,4">
                                                            <TextBlock Text="{Binding Category}"
                                                                       Foreground="{StaticResource PrimaryBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Border>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Size}"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                                   Foreground="{StaticResource SubtleBrush}"
                                                                   VerticalAlignment="Center" />

                                                        <StackPanel Grid.Column="4"
                                                                    Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource IconButton}"
                                                                    Margin="0,0,6,0"
                                                                    Tag="{Binding}"
                                                                    ToolTip="Export this file from the vault"
                                                                    Click="ExportFileRowButton_Click">
                                                                <Path Width="15"
                                                                      Height="15"
                                                                      Stretch="Uniform"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.8"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      Data="M12,4 L12,16 M8,12 L12,16 L16,12 M5,20 L19,20" />
                                                            </Button>
                                                            <Button Style="{StaticResource DangerIconButton}"
                                                                    Tag="{Binding}"
                                                                    ToolTip="Delete this encrypted file attachment"
                                                                    Click="DeleteFileRowButton_Click">
                                                                <Path Width="15"
                                                                      Height="15"
                                                                      Stretch="Uniform"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.8"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      Data="M6,7 L18,7 M9,7 L9,5 L15,5 L15,7 M8,9 L9,19 L17,19 L18,9" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel x:Name="EmptyFilesPanel"
                                                Grid.Row="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="280">
                                        <TextBlock Text="No files yet"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Import a file to encrypt it inside the local vault."
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,16" />
                                        <Button Style="{StaticResource PrimaryButton}"
                                                MinWidth="142"
                                                HorizontalAlignment="Center"
                                                Click="ImportFileButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="14"
                                                      Height="14"
                                                      Margin="0,0,8,0"
                                                      Stretch="Uniform"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Data="M12,20 L12,8 M8,12 L12,8 L16,12 M5,20 L19,20" />
                                                <TextBlock Text="Import file"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="SettingsContent" Visibility="Collapsed">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="26" MaxWidth="820">
                                    <TextBlock Text="Preferences"
                                               Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="Settings"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,0" />

                                    <TextBlock Text="Language" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="LanguageComboBox"
                                              Width="260"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="LanguageComboBox_SelectionChanged">
                                        <ComboBoxItem Content="English" Tag="en" />
                                        <ComboBoxItem Content="Portuguese" Tag="pt-BR" />
                                    </ComboBox>

                                    <CheckBox x:Name="HideToTrayCheckBox"
                                              Content="Hide to tray when closing the window"
                                              Checked="HideToTrayCheckBox_Changed"
                                              Unchecked="HideToTrayCheckBox_Changed" />

                                    <TextBlock Text="Storage"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="0,32,0,0" />
                                    <TextBlock Text="Vault database file" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="VaultPathInput" IsReadOnly="True" />
                                        <Button Grid.Column="2"
                                                ToolTip="Choose vault database"
                                                Click="BrowseVaultPathButton_Click">
                                            <TextBlock Text="Browse"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                        <Button Grid.Column="4"
                                                ToolTip="Use the default vault path"
                                                Click="UseDefaultVaultPathButton_Click">
                                            <TextBlock Text="Default"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Click="OpenReadmeMenuItem_Click">
                                            <TextBlock Text="Open README"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </StackPanel>

                                    <TextBlock Text="Master password"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="0,32,0,0" />
                                    <TextBlock Text="Local second factor" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Text="Adds a master password after Windows authorization. The local keyring remains tied to this Windows account, but the vault key is also wrapped by the master password." />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button x:Name="SetMasterPasswordButton"
                                                ToolTip="Set or change the LockerIt master password for this vault"
                                                Click="SetMasterPasswordButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="14"
                                                      Height="14"
                                                      Margin="0,0,8,0"
                                                      Stretch="Uniform"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Data="M12,2 C8.7,2 6,4.7 6,8 L6,10 L5,10 C3.9,10 3,10.9 3,12 L3,21 C3,22.1 3.9,23 5,23 L19,23 C20.1,23 21,22.1 21,21 L21,12 C21,10.9 20.1,10 19,10 L18,10 L18,8 C18,4.7 15.3,2 12,2 Z M8,10 L8,8 C8,5.8 9.8,4 12,4 C14.2,4 16,5.8 16,8 L16,10 Z" />
                                                <TextBlock Text="Set / change"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="RemoveMasterPasswordButton"
                                                Margin="8,0,0,0"
                                                ToolTip="Remove the LockerIt master password from this local keyring"
                                                Click="RemoveMasterPasswordButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="14"
                                                      Height="14"
                                                      Margin="0,0,8,0"
                                                      Stretch="Uniform"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Data="M6,7 L18,7 M9,7 L9,5 L15,5 L15,7 M8,9 L9,19 L17,19 L18,9" />
                                                <TextBlock Text="Remove"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="MasterPasswordStatusText"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0" />

                                    <TextBlock Text="Recovery"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="0,32,0,0" />
                                    <TextBlock Text="Cross-device recovery kit" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Text="The vault database can move between devices. The local Windows keyring does not. Export a Recovery Kit to wrap the vault master key with a recovery passphrase, then import it on another Windows account to create a new local keyring." />

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Background="#121311"
                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="16">
                                            <StackPanel>
                                                <TextBlock Text="Export Recovery Kit"
                                                           FontSize="15"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="Creates a small encrypted key package, separate from the vault database. The package is protected by a recovery passphrase and contains no plaintext passwords."
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Margin="0,8,0,14" />
                                                <Button x:Name="ExportRecoveryKitButton"
                                                        HorizontalAlignment="Left"
                                                        ToolTip="Export a passphrase-protected Recovery Kit for this vault"
                                                        Click="ExportRecoveryKitButton_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Width="14"
                                                              Height="14"
                                                              Margin="0,0,8,0"
                                                              Stretch="Uniform"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.8"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Data="M12,4 L12,16 M8,12 L12,16 L16,12 M5,20 L19,20" />
                                                        <TextBlock Text="Export kit"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2"
                                                Background="#121311"
                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="16">
                                            <StackPanel>
                                                <TextBlock Text="Import On This PC"
                                                           FontSize="15"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="Uses the vault database plus the Recovery Kit to unwrap the vault key, then stores a new Windows-protected keyring for the current Windows account."
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Margin="0,8,0,14" />
                                                <Button x:Name="ImportRecoveryKitButton"
                                                        HorizontalAlignment="Left"
                                                        ToolTip="Import a Recovery Kit and create a keyring for this Windows account"
                                                        Click="ImportRecoveryKitButton_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Width="14"
                                                              Height="14"
                                                              Margin="0,0,8,0"
                                                              Stretch="Uniform"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.8"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Data="M12,20 L12,8 M8,12 L12,8 L16,12 M5,20 L19,20" />
                                                        <TextBlock Text="Import kit"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Background="#121311"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Update local keyring"
                                                           FontSize="15"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="Refreshes the DPAPI-protected keyring for this Windows account using the already unlocked vault master key."
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Margin="0,6,0,0" />
                                            </StackPanel>
                                            <Button x:Name="ReprotectKeyringButton"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Re-save the current vault key into this Windows account keyring"
                                                    Click="ReprotectKeyringButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="14"
                                                          Height="14"
                                                          Margin="0,0,8,0"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Data="M17,7 C15.7,5.8 14,5 12,5 C8.1,5 5,8.1 5,12 C5,15.9 8.1,19 12,19 C14.6,19 16.9,17.6 18.1,15.5 M17,7 L17,3 L21,3 M7,17 L7,21 L3,21" />
                                                    <TextBlock Text="Refresh keyring"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="RecoveryStatusText"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0" />

                                    <TextBlock Text="Storage engine" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="StorageEngineText"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Text="SQLite stores the index and encrypted payloads. Every secret is encrypted before it reaches the database." />

                                    <TextBlock Text="Unlock state" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="UnlockDiagnosticText"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Grid x:Name="EntryModalOverlay"
                          Visibility="Collapsed"
                          Background="#AA0E0F0D"
                          Margin="-272,-82,-24,-56"
                          Panel.ZIndex="20">
                        <Border Width="660"
                                MaxHeight="660"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrushStrong}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="22,20,22,10">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource BareIconButton}"
                                            Width="38"
                                            Height="38"
                                            Padding="0"
                                            Foreground="{StaticResource InkBrush}"
                                            ToolTip="Close without saving"
                                            Click="CancelEntryButton_Click">
                                        <Path Width="14"
                                              Height="14"
                                              Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M6,6 L18,18 M18,6 L6,18" />
                                    </Button>
                                    <StackPanel>
                                        <TextBlock x:Name="ModalTitleText"
                                                   Text="New password"
                                                   FontSize="22"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Encrypted local vault entry"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <ScrollViewer Grid.Row="1"
                                              Margin="22,0,22,0"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="200" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="TitleInput" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="CategoryInput" SelectedIndex="0">
                                                    <ComboBoxItem Content="General" Tag="General" />
                                                    <ComboBoxItem Content="Work" Tag="Work" />
                                                    <ComboBoxItem Content="Personal" Tag="Personal" />
                                                    <ComboBoxItem Content="Finance" Tag="Finance" />
                                                    <ComboBoxItem Content="Social" Tag="Social" />
                                                    <ComboBoxItem Content="Developer" Tag="Developer" />
                                                    <ComboBoxItem Content="Other" Tag="Other" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="UserNameInput" />

                                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="PasswordInput" />
                                            <TextBox x:Name="PasswordRevealInput"
                                                     Visibility="Collapsed" />
                                            <Button x:Name="RevealButton"
                                                    Style="{StaticResource IconButton}"
                                                    Grid.Column="2"
                                                    ToolTip="Show or hide the password value"
                                                    Click="RevealButton_Click">
                                                <Path Width="16"
                                                      Height="16"
                                                      Stretch="Uniform"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Data="M2,12 C4.8,7.5 8.2,5.5 12,5.5 C15.8,5.5 19.2,7.5 22,12 C19.2,16.5 15.8,18.5 12,18.5 C8.2,18.5 4.8,16.5 2,12 Z M12,9 C13.7,9 15,10.3 15,12 C15,13.7 13.7,15 12,15 C10.3,15 9,13.7 9,12 C9,10.3 10.3,9 12,9 Z" />
                                            </Button>
                                            <Button Grid.Column="4"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTip="Generate a strong password"
                                                    Click="GenerateButton_Click">
                                                <Path Width="16"
                                                      Height="16"
                                                      Stretch="Uniform"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Data="M12,3 L13.2,8.8 L19,10 L13.2,11.2 L12,17 L10.8,11.2 L5,10 L10.8,8.8 Z M19,4 L19.6,6.4 L22,7 L19.6,7.6 L19,10 L18.4,7.6 L16,7 L18.4,6.4 Z" />
                                            </Button>
                                        </Grid>

                                        <TextBlock Text="URL" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="UrlInput" />

                                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="NotesInput"
                                                 MinHeight="112"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </ScrollViewer>

                                <Border Grid.Row="2"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="0,1,0,0"
                                        Padding="22,14">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                            <Button Margin="0,0,8,0"
                                                    ToolTip="Copy username to clipboard"
                                                    Click="CopyUserButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="14"
                                                          Height="14"
                                                          Margin="0,0,8,0"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Data="M8,8 L18,8 L18,18 L8,18 Z M5,15 L5,5 L15,5" />
                                                    <TextBlock Text="Copy user"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </StackPanel>
                                            </Button>
                                            <Button ToolTip="Copy password to clipboard"
                                                    Click="CopyPasswordButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="14"
                                                          Height="14"
                                                          Margin="0,0,8,0"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Data="M15,7 C15,9.2 13.2,11 11,11 C8.8,11 7,9.2 7,7 C7,4.8 8.8,3 11,3 C13.2,3 15,4.8 15,7 Z M14,10 L21,17 M18,17 L21,17 L21,14" />
                                                    <TextBlock Text="Copy password"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button x:Name="DeleteButton"
                                                    Style="{StaticResource DangerButton}"
                                                    Margin="0,0,8,0"
                                                    ToolTip="Delete this password entry"
                                                    Click="DeleteButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="14"
                                                          Height="14"
                                                          Margin="0,0,8,0"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Data="M6,7 L18,7 M9,7 L9,5 L15,5 L15,7 M8,9 L9,19 L17,19 L18,9" />
                                                    <TextBlock Text="Delete"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="CancelEntryButton"
                                                    Margin="0,0,8,0"
                                                    ToolTip="Close without saving"
                                                    Click="CancelEntryButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="14"
                                                          Height="14"
                                                          Margin="0,0,8,0"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Data="M6,6 L18,18 M18,6 L6,18" />
                                                    <TextBlock Text="Cancel"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource PrimaryButton}"
                                                    MinWidth="104"
                                                    ToolTip="Save this password entry"
                                                    Click="SaveButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="14"
                                                          Height="14"
                                                          Margin="0,0,8,0"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Data="M5,5 L17,5 L19,7 L19,19 L5,19 Z M8,5 L8,11 L16,11 M8,19 L8,14 L16,14 L16,19" />
                                                    <TextBlock Text="Save"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Background="#0E0F0D"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="ShellStatusText"
                               Margin="16,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SubtleBrush}"
                               FontSize="12" />
                    <TextBlock x:Name="VaultPathStatusText"
                               DockPanel.Dock="Right"
                               Margin="16,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource SubtleBrush}"
                               FontSize="12" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
